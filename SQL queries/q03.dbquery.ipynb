   "source": [
    "create or replace view q03 as \n",
    "select d.month_start,\n",
    "count(*) as claim_count,\n",
    "round(sum(f.billed_amount),2) as total_billed\n",
    "from fact_claims f\n",
    "join dim_date d\n",
    "on  f.admission_date_key = d.date_key\n",
    "group by d.month_start\n",
    "order by d.month_start"
   ]
  }
 ],
