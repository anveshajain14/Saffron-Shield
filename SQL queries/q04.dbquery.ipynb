   "source": [
    "create or replace view q04 as \n",
    "select \n",
    "claim_type,\n",
    "is_network_at_admission,\n",
    "count(case when status = 'settled' then 1 else 0 end) as settled_claims,\n",
    "round(avg(turnaround_days),2) as avg_turnaround_days\n",
    "from fact_claims\n",
    "group by claim_type, is_network_at_admission\n"
   ]
  }
