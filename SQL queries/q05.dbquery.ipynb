   "source": [
    "create or replace view q05 as \n",
    "select \n",
    "rejection_code,\n",
    "count(*) as rejected_count,\n",
    "round(count(*)/sum(count(*)) over (),4) as share_of_rejection\n",
    "from fact_claims\n",
    "where status = 'rejected'\n",
    "group by rejection_code"
   ]
  }
