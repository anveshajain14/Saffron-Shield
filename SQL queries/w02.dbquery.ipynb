   "source": [
    "CREATE OR REPLACE VIEW w02 AS\n",
    "SELECT\n",
    "  plan_code,\n",
    "  month_start,\n",
    "  loss_ratio,\n",
    "  ROUND(\n",
    "    AVG(loss_ratio) OVER (\n",
    "      PARTITION BY plan_code\n",
    "      ORDER BY month_start\n",
    "      ROWS BETWEEN 2 PRECEDING AND CURRENT ROW\n",
    "    ),\n",
    "    2\n",
    "  ) AS rolling_3m_loss_ratio\n",
    "FROM w01;"
   ]
  }
 ],
